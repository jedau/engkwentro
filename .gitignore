# Environment and local secrets — never commit these
.env
.env.local
.env.*.local
.dev.vars
**/.dev.vars

# Flutter compile-time defines (may hold Reown project id)
client/dart_defines.json

# NEAR CLI credentials (never ship)
neardev/
**/.near-credentials/
**/credentials.json

# Machine-local Android SDK path (also in client/android/.gitignore)
**/local.properties

# Rust
target/
**/target/
Cargo.lock.bak

# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins-dependencies
*.iml

# Android / iOS generated (belt-and-suspenders; also in client/*/.gitignore)
**/.gradle/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh

# Local screenshot / alignment debug dumps
client/assets/images/_btn-shot.png
client/assets/images/_btn-crop.png
client/assets/images/_screen-connect.png
client/assets/images/_android-*.png
client/assets/images/_ios-*.png
client/assets/images/_near-on-cream-debug.png
docs/assets/_*.png

# Node
node_modules/
.wrangler/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local artifacts
*.log
tmp/
*.wasm
neardev/
