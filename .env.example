# Engkwentro — environment template
# Copy to .env for local notes. .env is gitignored.
#
# The Flutter client does not read .env at runtime. Pass values at build:
#   flutter run --dart-define=MATCH_CONTRACT=play.engkwentro.testnet \
#     --dart-define=MAILBOX_URL=http://127.0.0.1:8787
# Or: cp client/dart_defines.json.example client/dart_defines.json
#   flutter run --dart-define-from-file=dart_defines.json

# ── WalletConnect / Reown (optional) ─────────────────────────────────────────
# Free project id from https://cloud.reown.com — only for the WalletConnect tile.
# Create play account works without it.
REOWN_PROJECT_ID=

# ── NEAR network ─────────────────────────────────────────────────────────────
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER=https://testnet.nearblocks.io

# ── Contracts (testnet) ──────────────────────────────────────────────────────
# Match is live. Registry and vault compile but are not required for play.
MATCH_CONTRACT_ACCOUNT=play.engkwentro.testnet
REGISTRY_CONTRACT_ACCOUNT=engkwentro-registry.testnet
VAULT_CONTRACT_ACCOUNT=engkwentro-vault.testnet

# ── Accounts used by the two-phone demo ──────────────────────────────────────
PLAYER_A_ACCOUNT=player1.engkwentro.testnet
PLAYER_B_ACCOUNT=player2.engkwentro.testnet

# ── Local OT mailbox ─────────────────────────────────────────────────────────
# Run: node scripts/mailbox_local.mjs
MAILBOX_URL=http://127.0.0.1:8787

# ── Economics model (projections only; see docs/ECONOMICS.md) ────────────────
NEAR_PRICE_USD=3.00
STAKING_APY=0.05
RAKE_BPS=150
MIN_STAKE_NEAR=250
PRO_TIER_MATCHES_AT_MIN=15
PRO_CAP_MAX_PER_DAY=50
UNSTAKE_DELAY_DAYS=7
GAS_REPORT_MATCHES_PER_MONTH=20

# ── Match parameters ─────────────────────────────────────────────────────────
CLOCK_MINUTES_MIN=1
CLOCK_MINUTES_MAX=15
SETTLEMENT_WINDOW_SECONDS=300
