#!/usr/bin/env bash
# Refuse a commit created while checked out on a protected branch.
# symbolic-ref reads the name before the first commit exists. Detached
# HEAD is not a branch, so a commit there is allowed.
set -euo pipefail

if branch="$(git symbolic-ref --quiet --short HEAD)"; then
  if [[ "$branch" == "main" || "$branch" == "master" ]]; then
    echo "Direct commits to '${branch}' are not allowed." >&2
    echo "Create a feature branch and commit there." >&2
    exit 1
  fi
fi
